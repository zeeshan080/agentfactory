{
  "name": "agentfactory-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/agentfactory-api/src",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/agentfactory-api",
        "command": "uv run python -m agentfactory_api.main"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/agentfactory-api",
        "command": "uv run pytest tests/ -v"
      },
      "cache": true,
      "inputs": ["pythonInputs"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/agentfactory-api",
        "command": "uv run ruff check src/"
      },
      "cache": true
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/agentfactory-api",
        "command": "uv run ruff format src/"
      }
    }
  }
}
