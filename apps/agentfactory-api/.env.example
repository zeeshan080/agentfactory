# AgentFactory API Configuration
# Copy to .env and fill in your values

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# For development, leave empty to use SQLite
# For production, use PostgreSQL connection string
AGENTFACTORY_DATABASE_URL=

# =============================================================================
# Cloudflare R2 Storage
# =============================================================================
# Required for production. Leave empty for development (mock mode).
AGENTFACTORY_R2_ACCOUNT_ID=
AGENTFACTORY_R2_ACCESS_KEY_ID=
AGENTFACTORY_R2_SECRET_ACCESS_KEY=
AGENTFACTORY_R2_BUCKET_NAME=agentfactory-content

# =============================================================================
# OpenAI API
# =============================================================================
# Required for production. Leave empty for development (mock mode).
AGENTFACTORY_OPENAI_API_KEY=
AGENTFACTORY_OPENAI_MODEL=gpt-4o

# =============================================================================
# Authentication (SSO)
# =============================================================================
# SSO server URL for JWT validation. Leave empty for development (anonymous mode).
AGENTFACTORY_AUTH_SERVER_URL=http://localhost:3001

# =============================================================================
# Server Configuration
# =============================================================================
AGENTFACTORY_SERVER_HOST=0.0.0.0
AGENTFACTORY_SERVER_PORT=8080

# CORS origins (comma-separated)
AGENTFACTORY_CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# =============================================================================
# Logging
# =============================================================================
AGENTFACTORY_LOG_LEVEL=INFO
